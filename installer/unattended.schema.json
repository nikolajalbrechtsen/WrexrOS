{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wrexr.io/schemas/unattended.schema.json",
  "title": "WrexrOS unattended installation configuration",
  "description": "Configuration accepted by wrexr-installer.sh --config. Unknown top-level keys are rejected. Passwords are sensitive: the configuration file must not be group- or world-readable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["hostname", "filesystem", "raid", "disks", "network", "auth"],
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1,
      "default": 1,
      "description": "Configuration format version."
    },
    "hostname": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$",
      "default": "wrexr"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_+/-]+$",
      "default": "UTC"
    },
    "keyboardLayout": {
      "type": "string",
      "pattern": "^[a-z]{2}(-[a-zA-Z0-9]+)?$",
      "default": "us"
    },
    "filesystem": {
      "type": "string",
      "enum": ["zfs", "btrfs", "ext4"],
      "default": "zfs",
      "description": "Filesystem for the root pool and the data storage pool."
    },
    "raid": {
      "type": "string",
      "enum": ["single", "mirror", "raidz1", "raidz2", "raidz10"],
      "default": "single",
      "description": "single = one device; mirror = RAID1/RAID10 style; raidz1/2 = ZFS parity; raidz10 = striped mirrors."
    },
    "swap": {
      "type": "boolean",
      "default": true,
      "description": "Create a swap partition on every system disk."
    },
    "swapSize": {
      "type": "string",
      "pattern": "^[0-9]+[KMGTP]$",
      "default": "4G"
    },
    "uiPort": {
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 8443,
      "description": "HTTPS port of wrexrd, written to /etc/wrexr/wrexrd.toml."
    },
    "updateChannel": {
      "type": "string",
      "enum": ["stable", "beta"],
      "default": "stable"
    },
    "repoUrl": {
      "type": "string",
      "pattern": "^https?://[^ \\t\\r\\n]+$",
      "default": "https://repo.wrexr.io"
    },
    "demoMode": {
      "type": "boolean",
      "default": false
    },
    "force": {
      "type": "boolean",
      "default": false,
      "description": "Unattended installs additionally require --yes. force=true records explicit consent to wipe the listed disks."
    },
    "packageSource": {
      "type": "string",
      "pattern": "^/[A-Za-z0-9._/-]+$",
      "default": "/run/live/medium/wrexr/packages"
    },
    "kernelOptions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[A-Za-z0-9_.=,/+-]+$"
      }
    },
    "disks": {
      "type": "array",
      "minItems": 1,
      "uniqueItemProperties": ["path"],
      "description": "Disk role assignments. Each path must appear exactly once; at least one system disk is required.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/dev/(sd[a-z]+|vd[a-z]+|xvd[a-z]+|nvme[0-9]+n[0-9]+|mmcblk[0-9]+|disk/by-id/[A-Za-z0-9._:-]+)$"
          },
          "role": {
            "type": "string",
            "enum": ["system", "parity", "data", "cache"]
          },
          "model": {
            "type": "string",
            "maxLength": 128
          },
          "wipe": {
            "type": "boolean",
            "default": true,
            "description": "Allow the installer to destroy all data on this disk."
          }
        }
      }
    },
    "network": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["dhcp", "static"],
          "default": "dhcp"
        },
        "interface": {
          "type": "string",
          "pattern": "^(auto|[A-Za-z0-9_.:-]{1,32})$",
          "default": "auto",
          "description": "Management NIC. Use 'auto' to detect the first physical interface."
        },
        "bridge": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,15}$",
          "default": "br0"
        },
        "address": {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "netmask": {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "gateway": {
          "type": "string",
          "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
        },
        "dns": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^((25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])\\.){3}(25[0-5]|2[0-4][0-9]|1[0-9]{2}|[1-9]?[0-9])$"
          }
        },
        "firewall": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean",
              "default": true
            },
            "allowTcp": {
              "type": "array",
              "description": "Inbound TCP ports; defaults to 22 and the configured uiPort.",
              "default": [22, 8443],
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              }
            }
          }
        }
      },
      "oneOf": [
        {
          "title": "DHCP",
          "required": ["mode"],
          "properties": { "mode": { "const": "dhcp" } }
        },
        {
          "title": "Static IPv4",
          "required": ["mode", "address", "netmask", "gateway", "dns"],
          "properties": { "mode": { "const": "static" } }
        }
      ]
    },
    "auth": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["password"] },
        { "required": ["sshKeys"] }
      ],
      "properties": {
        "password": {
          "type": "string",
          "minLength": 12,
          "maxLength": 256,
          "pattern": "^[^:\\r\\n]+$",
          "sensitive": true,
          "description": "Initial root password. Never commit it to a public repository."
        },
        "sshKeys": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 20,
            "pattern": "^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\\.com) [A-Za-z0-9+/=]+( .*)?$"
          }
        }
      }
    },
    "users": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z_][a-z0-9_-]{0,30}[a-z0-9_]$"
          },
          "groups": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,30}$"
            }
          },
          "shell": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9/_-]+$",
            "default": "/bin/bash"
          },
          "sshKeys": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "minLength": 20,
              "pattern": "^(ssh-(rsa|ed25519)|ecdsa-sha2-nistp(256|384|521)|sk-ssh-ed25519@openssh\\.com) [A-Za-z0-9+/=]+( .*)?$"
            }
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 256,
            "pattern": "^[^:\\r\\n]+$",
            "sensitive": true
          }
        }
      }
    },
    "shares": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "protocol"],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,30}$"
          },
          "protocol": {
            "type": "string",
            "enum": ["smb", "nfs", "ftp"]
          },
          "path": {
            "type": "string",
            "pattern": "^/[A-Za-z0-9._/-]+$",
            "default": "/mnt/wrexr/data"
          },
          "readOnly": {
            "type": "boolean",
            "default": false
          },
          "recycle": {
            "type": "boolean",
            "default": true
          },
          "users": {
            "type": "array",
            "default": [],
            "items": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_-]{0,30}$"
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "title": "At least one disk must have the system role",
      "type": "object",
      "properties": {
        "disks": {
          "type": "array",
          "contains": {
            "type": "object",
            "properties": { "role": { "const": "system" } },
            "required": ["role"]
          }
        }
      }
    }
  ]
}

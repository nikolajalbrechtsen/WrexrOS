#!/usr/bin/env bash
# WrexrOS live-ISO boot hook.
#
# Reads the kernel command line written by the ISOLINUX or GRUB menu and starts
# the matching installer path. Every menu entry states wrexr.install= explicitly;
# an empty value keeps the session in live/rescue mode.
set -Eeuo pipefail

CMDLINE="$(cat /proc/cmdline 2>/dev/null || true)"
INSTALL_MODE=""
CONFIG_SOURCE=""

# Last value wins. Menus append an explicit value (including an empty one for
# live/rescue mode), so this also neutralises any inherited image default.
for arg in $CMDLINE; do
  case "$arg" in
    wrexr.install=*) INSTALL_MODE="${arg#wrexr.install=}" ;;
    wrexr.config=*) CONFIG_SOURCE="${arg#wrexr.config=}" ;;
  esac
done

[[ -n "$INSTALL_MODE" ]] || exit 0

INSTALLER="/opt/wrexr/installer/wrexr-installer.sh"
if [[ ! -x "$INSTALLER" ]]; then
  echo "[wrexr-live-install] installer not found; staying in live session" >&2
  exit 0
fi

CONFIG_FILE=""
if [[ -n "$CONFIG_SOURCE" ]]; then
  case "$CONFIG_SOURCE" in
    http://*|https://*|ftp://*)
      CONFIG_FILE="$(mktemp /tmp/wrexr-install-XXXXXX.json)"
      echo "[wrexr-live-install] fetching $CONFIG_SOURCE"
      curl --fail --silent --show-error --location --max-time 60 \
        "$CONFIG_SOURCE" -o "$CONFIG_FILE"
      ;;
    *)
      # ISO9660/vfat files are often 0644. The validator requires 0600 when a
      # config contains a password, so always copy local configs to a safe path.
      if [[ ! -r $CONFIG_SOURCE && $(basename -- "$CONFIG_SOURCE") == autospec.json ]]; then
        candidate=""
        for candidate in \
          /run/live/medium/wrexr/autospec.json \
          /cdrom/wrexr/autospec.json \
          /media/*/wrexr/autospec.json \
          /autospec.json; do
          [[ -r $candidate ]] || continue
          CONFIG_SOURCE="$candidate"
          break
        done
      fi
      [[ -r "$CONFIG_SOURCE" ]] || {
        echo "[wrexr-live-install] config $CONFIG_SOURCE is not readable" >&2
        exit 1
      }
      CONFIG_FILE="$(mktemp /tmp/wrexr-install-XXXXXX.json)"
      cp -- "$CONFIG_SOURCE" "$CONFIG_FILE"
      chmod 0600 "$CONFIG_FILE"
      ;;
  esac
  [[ -r "$CONFIG_FILE" ]] || {
    echo "[wrexr-live-install] config $CONFIG_FILE is not readable" >&2
    exit 1
  }
fi

case "$INSTALL_MODE" in
  standard)
    echo "[wrexr-live-install] starting guided standard install"
    exec "$INSTALLER" --interactive
    ;;
  advanced)
    echo "[wrexr-live-install] starting advanced install"
    exec "$INSTALLER" --interactive --advanced
    ;;
  unattended)
    [[ -n "$CONFIG_FILE" ]] || {
      echo "[wrexr-live-install] unattended mode requires wrexr.config=" >&2
      exit 1
    }
    echo "[wrexr-live-install] starting unattended install from $CONFIG_FILE"
    exec "$INSTALLER" --config "$CONFIG_FILE" --yes
    ;;
  *)
    echo "[wrexr-live-install] unknown mode: $INSTALL_MODE" >&2
    exit 1
    ;;
esac

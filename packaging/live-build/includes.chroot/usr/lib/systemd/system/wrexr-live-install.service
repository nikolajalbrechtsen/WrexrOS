[Unit]
Description=WrexrOS live ISO installer autostart
Documentation=https://github.com/nikolajalbrechtsen/WrexrOS
ConditionPathExists=/proc/cmdline
After=network-online.target
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/wrexr-live-install
RemainAfterExit=yes
StandardInput=tty
StandardOutput=tty
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes

[Install]
WantedBy=multi-user.target
